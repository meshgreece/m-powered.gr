{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "m-powered",
  "compatibility_date": "2026-11-22",
  "assets": {
    "directory": "./build",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {"pattern": "m-powered.gr", "custom_domain": true}
  ]
}
